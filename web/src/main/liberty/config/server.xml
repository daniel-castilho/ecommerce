<?xml version="1.0" encoding="UTF-8"?>
<server description="Ecommerce modular monolith (Jakarta EE 11)">

    <featureManager>
        <feature>webProfile-11.0</feature>
        <feature>transportSecurity-1.0</feature>
        <feature>mail-2.1</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint" host="*" httpPort="9080" httpsPort="9443"/>

    <!-- Dev-only keystore: Liberty auto-generates key.p12 on first start with this password. -->
    <keyStore id="defaultKeyStore" password="keystore-password-dev"/>

    <!-- Open Liberty 26.0.0.4+ removed the default LTPA keys password (CVE-2025-14917).
         Without keysPassword the LTPA service fails (CWWKS4118E) and form login breaks. -->
    <ltpa keysPassword="keystore-password-dev"/>

    <library id="postgresLib">
        <fileset dir="${server.config.dir}/lib/global" includes="postgresql.jar"/>
    </library>

    <dataSource id="EcommerceDS" jndiName="jdbc/EcommerceDS">
        <jdbcDriver libraryRef="postgresLib"/>
        <properties.postgresql serverName="${env.DB_HOST}" portNumber="${env.DB_PORT}"
                               databaseName="${env.DB_NAME}" user="${env.DB_USER}"
                               password="${env.DB_PASSWORD}"/>
    </dataSource>

    <!-- Canonical Liberty mail-2.1 pattern: plain jndiName + @Resource(lookup="mail/Session").
         The java:app/env/... form is not resolvable by @Resource(name=...) here (CWNEN1004E). -->
    <mailSession id="EcommerceMail" mailSessionID="EcommerceMail" jndiName="mail/Session"
                 description="Ecommerce mail session" host="localhost" user="mailuser" password="mailpass"
                 from="noreply@loja.com"/>

</server>
