# Development defaults for the EcommerceDS datasource. Any of these can be
# overridden with a real OS environment variable (e.g. DB_PASSWORD) when
# deploying outside the docker dev stack; server.xml references them via
# ${env.DB_*}. These are dev-only credentials — never put production secrets here.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shop
DB_USER=user
DB_PASSWORD=password
